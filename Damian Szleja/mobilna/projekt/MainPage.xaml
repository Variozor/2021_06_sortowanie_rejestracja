<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rejestracja.MainPage" BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Spacing="8">
            <Label Text="Rejestruj konto" FontSize="26" BackgroundColor="#008080" TextColor="White" />
            <Label Text="Podaj e-mail:" TextColor="Black" />
            <Entry x:Name="Email" Placeholder="email" Keyboard="Email" TextColor="Black" PlaceholderColor="Gray" HorizontalOptions="Fill" />
            <Label Text="Podaj hasło:" TextColor="Black" />
            <Entry x:Name="Haslo" IsPassword="True" TextColor="Black" HorizontalOptions="Fill" />
            <Label Text="Powtórz hasło:" TextColor="Black" />
            <Entry x:Name="PowtorzoneHaslo" IsPassword="True" TextColor="Black" HorizontalOptions="Fill" />
            <Button Text="ZATWIERDŹ" HorizontalOptions="Center" BackgroundColor="LightGray" TextColor="Black" Clicked="Zatwierdz" />
            <Label x:Name="Komunikat" Text="Autor Damian Szleja" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="Black" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
